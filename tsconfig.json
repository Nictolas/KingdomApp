{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "module": "esnext",
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "types": [
      "react",
      "react-native",
      "node"
    ]
  },
  "exclude": [
    "node_modules",
    "dist",
    "assets/source-packs"
  ]
}
