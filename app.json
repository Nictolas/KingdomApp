{
  "expo": {
    "name": "MyKingdom",
    "slug": "mykingdom",
    "scheme": "mykingdom",
    "version": "0.1.0",
    "orientation": "default",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0b3d1f"
      }
    },
    "plugins": [
      "expo-router",
      "expo-asset"
    ]
  }
}
